<section class="hero" aria-labelledby="intro-title">
  <div class="hero-eyebrow"><span class="eyebrow"><span class="status-dot" aria-hidden="true"></span> GAME PROGRAMMER</span><span class="eyebrow hero-location">MONTRÉAL, CANADA</span></div>
  <h1 id="intro-title">Built for play.<br><span>Made to work.</span></h1>
  <div class="hero-bottom"><p>I’m Runze, a programmer building gameplay, developer tools, and the tests that keep everything working.</p><a class="text-link hero-cta" href="#selected-work">Explore my work <span aria-hidden="true">↓</span></a></div>
  <div class="hero-caption"><span>Currently at <a href="<%= url_for('/about/#experience') %>">Ubisoft Montréal ↗</a></span><span>C++ <span aria-hidden="true">/</span> UNREAL <span aria-hidden="true">/</span> UNITY</span></div>
</section>
<section class="section" id="selected-work" aria-labelledby="work-title">
  <div class="section-heading"><h2 id="work-title"><span class="section-index">01 /</span> Selected work</h2><a class="text-link" href="<%= url_for('/projects/') %>">All projects <span aria-hidden="true">↗</span></a></div>
  <div class="project-grid"><% site.data.projects.filter(p => p.featured).forEach(project => { %><%- partial('_partial/card', {project}) %><% }) %></div>
</section>
<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="section-heading"><h2 id="experience-title"><span class="section-index">02 /</span> Where I’ve been</h2><a class="text-link" href="<%= url_for('/Runze_Zhu_Resume.pdf') %>">Full résumé <span aria-hidden="true">↗</span></a></div>
  <%- partial('_partial/experience') %>
</section>
<section class="about-strip"><span class="eyebrow">A LITTLE MORE HUMAN</span><div><h2>Games, good music,<br>and a little curiosity.</h2><p>Originally from China, now in Montréal. A Computer Science graduate, game jam regular, and music lover.</p><a class="text-link" href="<%= url_for('/about/') %>">More about me <span aria-hidden="true">↗</span></a></div></section>
